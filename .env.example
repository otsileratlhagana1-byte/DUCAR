# Copy these into your local .env for Pydroid testing.
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=sqlite:///ducar_fest.db

EVENT_NAME=DUCAR FEST 3.0
EVENT_TAGLINE=Lekempo Edition
EVENT_DATE=26 December 2026
EVENT_VENUE=BOCHUM, GEMARK — BABIRWA BAR LOUNGE
CURRENCY=R
MAX_PER_ORDER=10

# Payment: use sandbox for testing, live after your PayFast account is approved.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Public HTTPS URL. Required for PayFast ITN and WhatsApp media.
PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com

# Admin/creator accounts — CHANGE THESE BEFORE PRODUCTION.
ADMIN_EMAIL=your-real-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
CREATOR_EMAIL=your-real-creator-email@example.com
CREATOR_PASSWORD=replace-with-a-strong-creator-password

# Optional email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional WhatsApp via Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+27649912526
